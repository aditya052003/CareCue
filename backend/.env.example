# CareCue backend environment variables
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

#
# Server
#

# Port the Express server listens on (default: 5000)
# PORT=5000

#
# Storage adapter
#

# Set to "dynamodb" to use Amazon DynamoDB.
# Leave unset (or set to any other value) to use the local SQLite database.
# CARECUE_STORAGE=dynamodb

# Path to the SQLite database file (default: ./carecue.db).
# Override in tests to point at a temp file.
# DB_PATH=./carecue.db

#
# DynamoDB settings (only used when CARECUE_STORAGE=dynamodb)
#

# AWS region where the CareCueCheckIns table lives.
# AWS_REGION=ap-south-1

# DynamoDB table name (default: CareCueCheckIns).
# CARECUE_TABLE=CareCueCheckIns

#
# AWS credentials
#

# Do NOT put credentials here. Use one of the standard provider-chain methods:
#
#   1. IAM role attached to the compute resource (EC2, Lambda, ECS) -- preferred
#   2. AWS CLI profile:  aws configure
#   3. Environment variables set outside this file:
#        AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN
#
# The AWS SDK resolves credentials automatically via its provider chain.

#
# AI / Bedrock (optional)
#


# Set to "true" or "1" to enable Amazon Bedrock for the chat endpoint.
# Requires @aws-sdk/client-bedrock-runtime to be installed.
# CARECUE_USE_BEDROCK=false

# Bedrock model ID (default: anthropic.claude-3-haiku-20240307-v1:0)
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Remote CareCue MCP server
# Keep the real token private; never commit it.
# CARECUE_MCP_URL=https://3rkx4656ghxd50r5.8lc.lambda-web.ap-south-1.on.aws/mcp
# CARECUE_MCP_TOKEN=
